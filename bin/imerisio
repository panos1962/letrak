# @FILETYPE BEGIN
# bash
# @FILETYPE END
#
# @FILE BEGIN
# bin/imerisio —— Εκτύπωση δελτίων κατά ημερομηνία και οργανική μονάδα
# @FILE END
#
# @DESCRIPTION BEGIN
#
# Το παρόν πρόγραμμα εκτυπώνει δελτία, το ένα κάτω από το άλλο, για
# συγκεκριμένο χρονικό διάστημα και συγκεκριμένες οργανικές μονάδες.
# Κύριος σκοπός του προγράμματος είναι να παραχθεί text file που να
# περιέχει την ζητούμενη πληροφορία, κυρίως για λόγους εφεδρείας
# (harcopy backup).
#
# @DESCRIPTION END
#
# @HISTORY BEGIN
# Created: 2026-02-09
# @HISTORY END
#
# @END

progname="$(basename $0)"

usage() {
	echo "usage: ${progname} [ OPTIONS ]
OPTIONS
-------
-u dbuser
-p
-i υπηρεσία
-f από
-t έως" >&2
	exit 1
}

[ -z "${LETRAK_BASEDIR}" ] &&
LETRAK_BASEDIR="/var/opt/letrak"

checkdate() {
	date -d "${1}" '+%Y-%m-%d' 2>/dev/null && return 0

	echo "${progname}: ${1}: invalid date" >&2
	return 1
}

dbuser=
dbpass="read"
ipmask=
apo=
eos=

err=

while getopts ":u:pi:f:t:" opt
do
	case "${opt}" in
	u)
		dbuser="${OPTARG}"
		;;
	p)
		dbpass=""
		;;
	i)
		ipmask="${ipmask},${OPTARG}"
		;;
	f)
		apo="$(checkdate "${OPTARG}")" || err=1
		;;
	t)
		eos="$(checkdate "${OPTARG}")" || err=1
		;;
	\?)
		echo "${progname}: -${OPTARG}: invalid option" >&2
		err=1
		;;
	\:)
		echo "${progname}: -${OPTARG}: missing argument" >&2
		err=1
		;;
	esac
done

[ -n "${err}" ] && usage

shift $(expr ${OPTIND} - 1)
[ $# -ne 0 ] && usage

awk \
-v progname="${progname}" \
-v dbuser="${dbuser}" \
-v dbpass="${dbpass}" \
-v ipmask="${ipmask}" \
-v apo="${apo}" \
-v eos="${eos}" \
-f "${LETRAK_BASEDIR}/lib/imerisio.awk" 
